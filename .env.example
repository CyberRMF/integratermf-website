# Required Vercel environment variables for /api/beta-signup and /api/activate-airgap

# Keygen.sh — your account ID (found on the Keygen dashboard)
KEYGEN_ACCOUNT_ID=90f7757f-ee38-4977-b21d-89f287d21f0d

# Keygen.sh — admin API token (Settings > API Tokens > Generate)
KEYGEN_ADMIN_TOKEN=your-admin-token-here

# Keygen.sh — the beta policy ID you created
KEYGEN_POLICY_ID=your-beta-policy-id-here

# Resend.com — API key (Settings > API Keys)
RESEND_API_KEY=your-resend-api-key-here

# Resend.com — audience ID for the "CyberRMF Users" audience.
# Create in Resend dashboard > Audiences > Create audience, then copy the ID.
# When set, new beta/trial signups are auto-added as contacts, and
# /api/unsubscribe flips their unsubscribed flag so future broadcasts skip them.
# If unset, signup still works, contacts are just not synced.
RESEND_AUDIENCE_ID=your-audience-id-here

# HMAC secret for signing one-click unsubscribe URLs. Must be a long random
# string (>= 32 chars). Generate with:  openssl rand -base64 32
# If unset, unsubscribe falls back to mailto-only (still works, just manual).
# Rotating this invalidates every previously-sent unsubscribe link.
UNSUBSCRIBE_SECRET=your-long-random-string-here

# Physical business postal address shown in email footers (CAN-SPAM / CASL
# requirement). Should be a real, deliverable address: street + suite/PO Box,
# city, state, ZIP, country. PO Box or CMRA (iPostal1, Earth Class Mail) OK.
# Example: CyberRMF LLC · 123 Main St, Suite 400, Austin, TX 78701, USA
BUSINESS_ADDRESS=CyberRMF LLC - [your address here]

# GitHub Release download URLs for the .exe installers
GITHUB_DOWNLOAD_INTEGRATE=https://github.com/CyberRMF/betaIntegrateAdminTools/releases/download/v1.0.0-beta/CyberRMF.Integrate.Setup.1.0.0.exe
GITHUB_DOWNLOAD_ADMIN=https://github.com/CyberRMF/betaIntegrateAdminTools/releases/download/v1.0.0-beta/CyberRMF.Admin.Tools.Setup.1.0.0.exe

# Ed25519 private key that signs air-gapped response codes (base64 PKCS#8).
# Created by scripts/make-airgap-keys.js in the app repo, which also puts the
# matching public key into the apps. Never commit the real value. Replacing
# it means a new app build, and every response code issued so far stops working.
AIRGAP_SIGNING_KEY=
