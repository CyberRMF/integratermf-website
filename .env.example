# Required Vercel environment variables for /api/beta-signup and /api/activate-airgap

# Keygen.sh — your account ID (found on the Keygen dashboard)
KEYGEN_ACCOUNT_ID=90f7757f-ee38-4977-b21d-89f287d21f0d

# Keygen.sh — admin API token (Settings > API Tokens > Generate)
KEYGEN_ADMIN_TOKEN=your-admin-token-here

# Keygen.sh — the beta policy ID you created
KEYGEN_POLICY_ID=your-beta-policy-id-here

# Resend.com — API key (Settings > API Keys)
RESEND_API_KEY=your-resend-api-key-here

# GitHub Release download URLs for the .exe installers
GITHUB_DOWNLOAD_INTEGRATE=https://github.com/CyberRMF/betaIntegrateAdminTools/releases/download/v1.0.0-beta/CyberRMF.Integrate.Setup.1.0.0.exe
GITHUB_DOWNLOAD_ADMIN=https://github.com/CyberRMF/betaIntegrateAdminTools/releases/download/v1.0.0-beta/CyberRMF.Admin.Tools.Setup.1.0.0.exe

# Air-gapped activation shared HMAC secret. Must match the constant
# AIRGAP_SECRET in shared/shared/ipc/keygen.ts (compiled into the Electron apps).
# If you rotate this, all previously-issued response codes stop verifying.
AIRGAP_SECRET=CyberRMF-Airgap-v1-b7d3f28c-a94e-11ee-be56-0242ac120002
