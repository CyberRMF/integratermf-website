{
  "routes": [
    { "src": "/api/(.*)",            "dest": "/api/$1" },
    { "src": "/\\.well-known/(.*)",  "dest": "/.well-known/$1" },
    { "src": "/images/(.*)",         "dest": "/images/$1" },
    { "src": "/coming-soon\\.html",  "dest": "/coming-soon.html" },
    { "src": "/.*",                  "dest": "/coming-soon.html" }
  ]
}
