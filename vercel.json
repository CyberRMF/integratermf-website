{
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": { "eq": "integratermf.com" } }],
      "status": 307,
      "headers": {
        "Location": "https://www.integratermf.com/$1",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload"
      }
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" }
  ],
  "redirects": [
    { "source": "/activate",   "destination": "/deactivate.html?action=activate&mode=airgap",   "permanent": false },
    { "source": "/activate/",  "destination": "/deactivate.html?action=activate&mode=airgap",   "permanent": false },
    { "source": "/deactivate",  "destination": "/deactivate.html", "permanent": false },
    { "source": "/deactivate/", "destination": "/deactivate.html", "permanent": false },
    { "source": "/updates",    "destination": "/updates.html", "permanent": false },
    { "source": "/updates/",   "destination": "/updates.html", "permanent": false },
    { "source": "/purchase.html", "destination": "/coming-soon.html", "permanent": false },
    { "source": "/request.html",  "destination": "/coming-soon.html", "permanent": false },
    { "source": "/trial.html",    "destination": "/coming-soon.html", "permanent": false },
    { "source": "/do-not-sell.html", "destination": "/privacy.html#section-8", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "accelerometer=(), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; worker-src 'none'; manifest-src 'self'" }
      ]
    },
    {
      "source": "/deactivate.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self' 'sha256-IYZFd5s+mDAqpgtAP3kEa0z3t2kSiS6AI507IkqUs8Q='; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src 'self'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types 'none'" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" }
      ]
    }
  ]
}
